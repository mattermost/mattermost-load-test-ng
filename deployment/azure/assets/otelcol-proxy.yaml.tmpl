receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318
  filelog/proxy_error:
    include: [ /var/log/nginx/error.log ]
    resource:
      service.name: "proxy"
      service.instance.id: "${INSTANCE_NAME}"
    operators:
      - type: regex_parser
        regex: '^(?P<time>\d{4}\/\d{2}\/\d{2} \d{2}:\d{2}:\d{2}) \[(?P<sev>[a-z]*)\] (?P<msg>.*)$'
        timestamp:
          parse_from: attributes.time
          layout: '%Y/%m/%d %H:%M:%S'
        severity:
          parse_from: attributes.sev
  filelog/proxy_access:
    include: [ /var/log/nginx/access.log ]
    resource:
      service.name: "proxy"
      service.instance.id: "${INSTANCE_NAME}"
    operators:
      - type: json_parser
        timestamp:
          layout: 's.ms'
          layout_type: epoch
          parse_from: attributes.ts

exporters:
  otlphttp/logs:
    endpoint: "http://${METRICS_IP}:3100/otlp"
    tls:
      insecure: true

service:
  pipelines:
    logs:
      receivers: [filelog/proxy_error, filelog/proxy_access]
      exporters: [otlphttp/logs]
