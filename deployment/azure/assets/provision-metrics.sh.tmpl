#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# apt mirrors are occasionally inconsistent right after adding a new repo / on a fresh
# mirror sync - retry transient failures instead of aborting the whole provisioning run.
retry() { local n=0; until "$@"; do n=$((n+1)); [ "$n" -ge 5 ] && return 1; sleep $((n*5)); done; }

retry sudo apt-get update -y
retry sudo apt-get install -y prometheus prometheus-node-exporter adduser libfontconfig1 musl gnupg2

if ! dpkg -s grafana &>/dev/null; then
  wget -q https://dl.grafana.com/oss/release/grafana_11.6.1_amd64.deb -O /tmp/grafana.deb
  sudo dpkg -i /tmp/grafana.deb
fi

if ! command -v loki &>/dev/null; then
  wget -q https://github.com/grafana/loki/releases/download/v3.2.0/loki_3.2.0_amd64.deb -O /tmp/loki.deb
  sudo dpkg -i /tmp/loki.deb
fi

sudo tee /etc/prometheus/prometheus.yml >/dev/null <<'PROMCONF'
${PROMETHEUS_YML}
PROMCONF

sudo mkdir -p /etc/grafana/provisioning/datasources /etc/grafana/provisioning/dashboards /var/lib/grafana/dashboards
sudo tee /etc/grafana/provisioning/datasources/datasource.yaml >/dev/null <<'DSCONF'
${GRAFANA_DATASOURCE}
DSCONF
sudo tee /etc/grafana/provisioning/dashboards/dashboard.yaml >/dev/null <<'DASHPROV'
${GRAFANA_DASHBOARD_PROVIDER}
DASHPROV
sudo tee -a /etc/grafana/grafana.ini >/dev/null <<'GFAUTH'
${GRAFANA_AUTH_INI}
GFAUTH

sudo systemctl daemon-reload
sudo systemctl enable --now prometheus prometheus-node-exporter loki

# `grafana-cli admin reset-admin-password` runs its own embedded migration runner against
# the same sqlite file. Running it concurrently with (or right after starting) grafana-server
# races both processes against the same DB and corrupts the migration ("no such column"
# errors) - so reset the password with the server stopped, THEN start grafana-server.
#
# `grafana-cli` here runs as root (via sudo), and since grafana-server hasn't started yet this
# is the first thing to touch grafana.db - it creates it owned by root, which then makes
# grafana-server (running as the "grafana" user) fail with "unable to open database file:
# permission denied" and crash-loop until systemd gives up. Reassert grafana:grafana ownership
# on the whole data dir before starting the service.
sudo systemctl enable grafana-server
retry sudo grafana-cli admin reset-admin-password "${GRAFANA_ADMIN_PASSWORD}"
sudo chown -R grafana:grafana /var/lib/grafana
sudo systemctl start grafana-server

# nginx + certbot fronting Grafana (public), Grafana itself only listens on localhost:3000.
wget -qO - https://nginx.org/keys/nginx_signing.key | gpg --dearmor | sudo tee /etc/apt/trusted.gpg.d/nginx.gpg >/dev/null
sudo sh -c 'echo "deb [arch=amd64] http://nginx.org/packages/mainline/ubuntu/ $(lsb_release -cs) nginx" > /etc/apt/sources.list.d/nginx.list'
retry sudo apt-get update -y
retry sudo apt-get install -y nginx

sudo mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
sudo rm -f /etc/nginx/sites-enabled/default
sudo tee /etc/nginx/nginx.conf >/dev/null <<'NGINXMAIN'
${NGINX_GRAFANA_MAIN}
NGINXMAIN
sudo tee /etc/nginx/sites-available/grafana >/dev/null <<'SITECONF'
${NGINX_GRAFANA_SITE}
SITECONF
sudo ln -fs /etc/nginx/sites-available/grafana /etc/nginx/sites-enabled/grafana
sudo nginx -t
sudo systemctl enable nginx
sudo systemctl restart nginx

sudo snap install core; sudo snap refresh core
sudo snap install --classic certbot
sudo ln -sf /snap/bin/certbot /usr/bin/certbot
sudo certbot --nginx --non-interactive --agree-tos -m ${LE_EMAIL} -d ${METRICS_FQDN} --redirect || \
  echo "WARNING: certbot failed - the public HTTPS listener on 443 will not have a valid cert until this is re-run manually."

echo "metrics provisioning complete"
