upstream backend {
  server ${APP1_IP}:8065 max_fails=0;
  server ${APP2_IP}:8065 max_fails=0;
  keepalive 256;
}

proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=mattermost_cache:10m max_size=3g inactive=60m use_temp_path=off;

# Public HTTPS entry point for real users. certbot --nginx -d ${PROXY_FQDN} rewrites this
# block in place to add the TLS listener + HTTP->HTTPS redirect.
server {
  listen 80;
  server_name ${PROXY_FQDN};

  location ~ /api/v[0-9]+/(users/)?websocket$ {
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include /etc/nginx/snippets/proxy.conf;
  }

  location ~ /api/v[0-9]+/users/[a-z0-9]+/image$ {
    proxy_set_header Connection "";
    include /etc/nginx/snippets/proxy.conf;
    include /etc/nginx/snippets/cache.conf;
    proxy_ignore_headers Cache-Control Expires;
    proxy_cache_valid 200 24h;
  }

  location / {
    proxy_set_header Connection "";
    include /etc/nginx/snippets/proxy.conf;
    include /etc/nginx/snippets/cache.conf;
  }
}

# Plain-HTTP listener for the load-test VM only (NSG nsg-proxy allows 8065 from snet-loadtest
# only, never from Internet). Matches the live Confluence spec: agent VM -> Mattermost on
# 8065/HTTP+WS. Same load-balanced backend as the public listener above.
server {
  listen 8065;
  server_name _;

  location ~ /api/v[0-9]+/(users/)?websocket$ {
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include /etc/nginx/snippets/proxy.conf;
  }

  location / {
    proxy_set_header Connection "";
    include /etc/nginx/snippets/proxy.conf;
  }
}
